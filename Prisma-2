@Composable
fun MessageBubble(text: String, outgoing: Boolean, style: ChatStyle) {
    val r = style.corner.dp
    val shape = RoundedCornerShape(
        topStart = r, topEnd = r,
        bottomStart = if (outgoing) r else 4.dp,
        bottomEnd = if (outgoing) 4.dp else r
    )
    Row(
        Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 3.dp),
        horizontalArrangement = if (outgoing) Arrangement.End else Arrangement.Start
    ) {
        Box(
            Modifier.widthIn(max = 300.dp)
                .background(Color(if (outgoing) style.bubbleOut else style.bubbleIn), shape)
                .padding(horizontal = 12.dp, vertical = 8.dp)
        ) {
            Text(
                text,
                color = Color(if (outgoing) style.textOut else style.textIn),
                fontSize = (16 * style.fontScale).sp
            )
        }
    }
}

