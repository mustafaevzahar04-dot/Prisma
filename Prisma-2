@Composable
fun PrismaApp(store: StyleStore) {
    val auth by Td.auth.collectAsState()
    var screen by remember { mutableStateOf<Screen>(Screen.Chats) }
    Surface(Modifier.fillMaxSize()) {
        if (auth is TdApi.AuthorizationStateReady) {
            when (val s = screen) {
                is Screen.Chats -> ChatList(
                    onOpen = { screen = Screen.Chat(it.id, it.title) },
                    onProfile = { screen = Screen.Profile }
                )
                is Screen.Chat -> ChatScreen(
                    s, store,
                    back = { screen = Screen.Chats },
                    edit = { screen = Screen.Style(s.id, s.title) }
                )
                is Screen.Profile -> ProfileScreen { screen = Screen.Chats }
